{
  "name": "swifty-sentry",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "swifty.js",
    "sentry",
    "server"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf ./client/logs ./client/dist ./server/logs ./server/dist",
    "format": "concurrently \"pnpm --filter @swifty.js/sentry format\" \"pnpm --filter client format\" \"pnpm --filter server format\"",
    "typecheck": "concurrently \"pnpm --filter @swifty.js/sentry typecheck\" \"pnpm --filter client typecheck\" \"pnpm --filter server typecheck\"",
    "client:dev:webpack": "pnpm --filter client dev:webpack",
    "client:dev": "pnpm --filter client dev",
    "client:build:webpack": "pnpm --filter client build:webpack",
    "client:build": "pnpm --filter client build",
    "build": "pnpm --filter @swifty.js/sentry build && concurrently \"pnpm client:build\" \"pnpm --filter server build\"",
    "client:preview:webpack": "pnpm --filter client preview:webpack",
    "client:preview": "pnpm --filter client preview",
    "server": "pnpm --filter server dev",
    "dev": "pnpm build && concurrently \"pnpm client:dev\" \"pnpm server\"",
    "dev:webpack": "concurrently \"pnpm client:dev:webpack\" \"pnpm server\"",
    "preview": "concurrently \"pnpm client:preview\" \"pnpm server\"",
    "preview:webpack": "concurrently \"pnpm client:preview:webpack\" \"pnpm server\"",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.5",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "./*.{js,cjs,mjs,jsx,ts,tsx,html,css,scss,json}": [
      "sh -c 'pnpm format'"
    ]
  }
}
